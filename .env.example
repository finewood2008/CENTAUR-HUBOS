# HubOS local runtime configuration.
# 路径类配置支持绝对路径、~/...，也支持相对路径；相对路径按仓库/发布包根目录解析。

HUBOS_FRONTEND_MODE=dev
HUBOS_ALLOW_SYSTEM_PYTHON=0
HUBOS_ALLOW_PIP_INSTALL=0
HUBOS_ALLOW_NPM_INSTALL=1

HUBOS_API_PORT=3456
HUBOS_FRONTEND_PORT=5173
QEECLAW_HERMES_BRIDGE_PORT=21747
QEECLAW_HUD_PORT=8134

VITE_BRIDGE_URL=http://127.0.0.1:21747
VITE_CHANNELS_BRIDGE_URL=http://127.0.0.1:21747
VITE_HUBOS_API_URL=http://127.0.0.1:3456

# 默认目录布局会自动发现 Node/Python runtime；非标准部署时才需要打开下面两项覆盖。
# HUBOS_NODE_BIN=runtime/node/bin/node
# QEECLAW_HERMES_BRIDGE_PYTHON=runtime/python-venv/bin/python3

QEECLAW_HERMES_AGENT_DIR=vendor/hermes-agent
QEECLAW_HUD_DIR=vendor/hermes-hudui
HERMES_HOME=~/.qeeclaw_hermes

# Local knowledge vector store. The embedding model must be packaged locally;
# runtime will not download models or call cloud embedding APIs.
QEECLAW_KB_VECTOR_BACKEND=chromadb
QEECLAW_KB_EMBEDDING_MODEL=qwen3-embedding-0.6b-q4_0
QEECLAW_KB_EMBEDDING_ENGINE=openai-compatible
QEECLAW_KB_EMBEDDING_API_URL=http://127.0.0.1:8091/v1/embeddings
QEECLAW_KB_EMBEDDING_DEVICE=cpu
QEECLAW_KB_EMBEDDING_DIMENSION=1024
# Default layout auto-discovers these from sibling qeeclaw-server:
# QEECLAW_KB_DIR=qeeclaw-server/release/<standalone>/data/knowledge
# QEECLAW_KB_EMBEDDING_MODEL_FILE=qeeclaw-server/release/<standalone>/models/Qwen3-Embedding-0.6B-Q4_0.gguf

# LLM runtime. 客户机必须配置真实模型凭证，否则对话会报 No local runtime credentials。
# DeepSeek 示例：
# HERMES_PROVIDER=deepseek
# HERMES_MODEL=deepseek/deepseek-v3.2-exp
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#
# DashScope/Qwen 示例：
# HERMES_PROVIDER=alibaba
# HERMES_MODEL=qwen-plus
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
